# Copy this file to .env and fill in your own values. Never commit .env.

# ntfy push notifications: pick a long, random, hard-to-guess topic name,
# subscribe to it in the ntfy iPhone app, and paste it here.
NTFY_TOPIC=
# Optional: a self-hosted ntfy server (default https://ntfy.sh)
NTFY_SERVER=https://ntfy.sh

# Which Claude model the agent uses (any model your Claude plan can use).
DINEWOLFIE_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high
DINEWOLFIE_EFFORT=medium

# sample = use the committed sample days in data/sample/ (default; works offline, any date)
# live   = today's menus from the cache in data/menus/
DINEWOLFIE_DATA_MODE=sample

# Contacting Nutrislice is OFF by default. We asked SBU Campus Dining for permission and
# have no answer yet: leave this off. If permission is granted, set it to on. Any refusal
# or rate limit from the server then stops all fetching immediately.
DINEWOLFIE_LIVE_FETCH=off

# Do NOT set ANTHROPIC_API_KEY unless you deliberately want API billing:
# an API key takes precedence over your Claude plan login.
