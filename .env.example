# Copy this file to .env and fill in your own values. Never commit .env.

# ntfy push notifications: pick a long, random, hard-to-guess topic name,
# subscribe to it in the ntfy iPhone app, and paste it here.
NTFY_TOPIC=
# Optional: a self-hosted ntfy server (default https://ntfy.sh)
NTFY_SERVER=https://ntfy.sh

# fast (default): the app gathers your memory + both halls' menus first and the AI decides in ~1 step.
# thorough: the AI does every lookup itself (slower, shows more of its reasoning).
DINEWOLFIE_MODE=fast

# Which Claude model the agent uses. claude-haiku-5-5 is the fastest and cheapest;
# claude-sonnet-5-5 and claude-opus-5-5 are bigger, slower and cost more.
DINEWOLFIE_MODEL=claude-haiku-5-5
# Reasoning effort: low | medium | high (fast mode uses DINEWOLFIE_FAST_EFFORT, default low)
DINEWOLFIE_EFFORT=medium

# live   = today's menus from Nutrislice, cached in data/menus/ (default)
# sample = the committed sample days in data/sample/ (works offline, any date)
DINEWOLFIE_DATA_MODE=live

# SBU Campus Dining gave permission, so fetching menus from Nutrislice is on. Set to off to never
# contact Nutrislice. Any refusal or rate limit from the server stops all fetching immediately.
DINEWOLFIE_LIVE_FETCH=on

# Terminal / morning run engine: claude (default; your Claude plan login) or groq
DINEWOLFIE_ENGINE=claude
# Needed only for the groq engine (https://console.groq.com/keys)
GROQ_API_KEY=
DINEWOLFIE_GROQ_MODEL=openai/gpt-oss-120b
# How long gpt-oss models think: low (fastest) | medium | high
DINEWOLFIE_GROQ_REASONING=low
# Optional: web lookup of nutrition for items the menu lists without it (https://tavily.com)
TAVILY_API_KEY=

# Do NOT set ANTHROPIC_API_KEY unless you deliberately want API billing:
# an API key takes precedence over your Claude plan login.
