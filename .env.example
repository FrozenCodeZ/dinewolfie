# Copy this file to .env and fill in your own values. Never commit .env.

# ntfy push notifications: pick a long, random, hard-to-guess topic name,
# subscribe to it in the ntfy iPhone app, and paste it here.
NTFY_TOPIC=
# Optional: a self-hosted ntfy server (default https://ntfy.sh)
NTFY_SERVER=https://ntfy.sh

# Which Claude model the agent uses (any model your Claude plan can use).
DINEWOLFIE_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high
DINEWOLFIE_EFFORT=medium

# live   = fetch real menus from Nutrislice (cached, at most once per station per day)
# sample = use the committed sample day in data/sample/ (works offline, any date)
DINEWOLFIE_DATA_MODE=live

# Do NOT set ANTHROPIC_API_KEY unless you deliberately want API billing:
# an API key takes precedence over your Claude plan login.
