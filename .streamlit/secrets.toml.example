# Template for Streamlit secrets. On Streamlit Community Cloud, paste the filled-in version into
# your app's  Settings > Secrets  box. For local testing, copy it to .streamlit/secrets.toml
# (that file is in .gitignore). Every section is optional; leave out what you don't use.

# Treat this as the public hosted site (guests get private, per-tab memory).
hosted = true

# --- AI engines: the app owner's keys -------------------------------------------------------
# By default only signed-in users may use these (they cost you money). Visitors can always paste
# their own key in the sidebar instead.
ANTHROPIC_API_KEY = ""   # https://console.anthropic.com  (Claude engine)
GROQ_API_KEY = ""        # https://console.groq.com/keys    (Groq engine, has a free tier)
TAVILY_API_KEY = ""      # https://app.tavily.com          (web nutrition lookup, optional)

# Only these signed-in emails may use the keys above. Empty list = any signed-in user.
allowed_emails = []
# Set to true to let even guests use your keys (not recommended on a public link).
share_keys_with_everyone = false

# Default models (visitors using your keys always get these). Optional.
# DINEWOLFIE_MODEL = "claude-haiku-5-5"
# DINEWOLFIE_GROQ_MODEL = "openai/gpt-oss-120b"

# --- Email + password accounts (Supabase) --------------------------------------------------------
# See docs/hosting.md step 2. Use the PUBLISHABLE key (sb_publishable_... or the legacy "anon" key),
# never the secret / service_role key.
[supabase]
url = "https://YOUR-PROJECT.supabase.co"
key = "sb_publishable_..."

# --- Google sign-in (st.login) ----------------------------------------------------------------
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "PASTE-A-LONG-RANDOM-STRING"
client_id = "PASTE-FROM-GOOGLE-CLOUD.apps.googleusercontent.com"
client_secret = "PASTE-FROM-GOOGLE-CLOUD"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Google Sheet that stores each user's memory ---------------------------------------------------
[gsheets]
sheet_id = "THE-LONG-ID-FROM-THE-SHEET-URL"
tab = "users"

# The service account's JSON key, converted to TOML (one line per field from the downloaded .json).
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "dinewolfie@YOUR-PROJECT.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
